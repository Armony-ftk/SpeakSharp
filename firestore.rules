rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function validProfile(data) {
      return data.keys().hasAll(['fullName', 'email', 'createdAt'])
        && data.keys().hasOnly(['fullName', 'email', 'createdAt'])
        && data.fullName is string
        && data.fullName.size() > 0
        && data.email is string
        && data.email.size() > 0
        && data.createdAt is timestamp;
    }

    function validSession(data) {
      return data.keys().hasAll([
          'title',
          'context',
          'targetDurationSeconds',
          'presentationDate',
          'status',
          'attemptCount',
          'latestRating',
          'bestRating',
          'ratingSum',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'title',
          'context',
          'targetDurationSeconds',
          'presentationDate',
          'status',
          'attemptCount',
          'latestRating',
          'bestRating',
          'ratingSum',
          'createdAt',
          'updatedAt'
        ])
        && data.title is string
        && data.title.size() > 0
        && (data.context == null || data.context is string)
        && (data.targetDurationSeconds == null
          || (data.targetDurationSeconds is int
            && data.targetDurationSeconds > 0))
        && (data.presentationDate == null || data.presentationDate is timestamp)
        && data.status in ['active', 'completed']
        && data.attemptCount is int
        && data.attemptCount >= 0
        && (data.latestRating == null || data.latestRating is number)
        && (data.bestRating == null || data.bestRating is number)
        && data.ratingSum is number
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function sessionAvailable(uid, sessionId) {
      return exists(/databases/$(database)/documents/users/$(uid)/sessions/$(sessionId))
        && !get(/databases/$(database)/documents/users/$(uid)/sessions/$(sessionId)).data.get('deleting', false);
    }

    function canonicalAudioPath(uid, sessionId, recordingId) {
      return 'recordings/' + uid + '/' + sessionId + '/' + recordingId + '.m4a';
    }

    function legacyAudioPath(uid, sessionId, recordingId) {
      return 'users/' + uid + '/sessions/' + sessionId + '/recordings/' + recordingId + '.m4a';
    }

    function validNewRecording(data, uid, sessionId, recordingId) {
      return data.keys().hasAll([
          'userId', 'sessionId', 'audioPath', 'durationSeconds',
          'processingStatus', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'userId', 'sessionId', 'audioPath', 'durationSeconds',
          'processingStatus', 'createdAt', 'updatedAt'
        ])
        && data.userId == uid && data.sessionId == sessionId
        && data.audioPath == canonicalAudioPath(uid, sessionId, recordingId)
        && data.durationSeconds is int
        && data.durationSeconds > 0 && data.durationSeconds <= 900
        && data.processingStatus == 'pending_upload';
    }

    function validLegacyPreparation(data, oldData, uid, sessionId, recordingId) {
      return !('processingStatus' in oldData) && oldData.status == 'pending_upload'
        && !data.keys().hasAny(['status', 'storagePath', 'duration'])
        && data.diff(oldData).affectedKeys().hasOnly([
          'userId', 'sessionId', 'audioPath', 'durationSeconds', 'processingStatus',
          'status', 'storagePath', 'duration', 'updatedAt'
        ])
        && data.userId == uid && data.sessionId == sessionId
        && data.durationSeconds == oldData.duration
        && data.durationSeconds is int
        && data.durationSeconds > 0 && data.durationSeconds <= 900
        && data.processingStatus == 'pending_upload'
        && data.audioPath == legacyAudioPath(uid, sessionId, recordingId)
        && oldData.get('storagePath', data.audioPath) == data.audioPath
        && data.updatedAt == request.time;
    }

    function validUploadReceipt(data, oldData) {
      // The function may already have progressed; only upload timestamps are client-writable.
      return 'audioPath' in oldData && 'processingStatus' in oldData
        && data.diff(oldData).affectedKeys().hasOnly(['uploadedAt', 'updatedAt'])
        && data.uploadedAt == request.time
        && data.updatedAt == request.time;
    }

    match /users/{uid} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid)
        && validProfile(request.resource.data)
        && request.resource.data.createdAt == request.time;
      allow update: if isOwner(uid)
        && validProfile(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if false;

      match /sessions/{sessionId} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid)
          && validSession(request.resource.data)
          && request.resource.data.status == 'active'
          && request.resource.data.attemptCount == 0
          && request.resource.data.latestRating == null
          && request.resource.data.bestRating == null
          && request.resource.data.ratingSum == 0
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time;
        allow update: if isOwner(uid)
          && !resource.data.get('deleting', false)
          && validSession(request.resource.data)
          && request.resource.data.attemptCount == resource.data.attemptCount
          && request.resource.data.latestRating == resource.data.latestRating
          && request.resource.data.bestRating == resource.data.bestRating
          && request.resource.data.ratingSum == resource.data.ratingSum
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.updatedAt == request.time;
        allow delete: if false;

        match /recordings/{recordingId} {
          allow read: if isOwner(uid);
          allow create: if isOwner(uid)
            && sessionAvailable(uid, sessionId)
            && validNewRecording(request.resource.data, uid, sessionId, recordingId)
            && request.resource.data.createdAt == request.time
            && request.resource.data.updatedAt == request.time;
          allow update: if isOwner(uid)
            && sessionAvailable(uid, sessionId)
            && (validUploadReceipt(request.resource.data, resource.data)
            || validLegacyPreparation(
              request.resource.data,
              resource.data,
              uid,
              sessionId,
              recordingId
            ));
          allow delete: if false;
        }
      }
    }
  }
}
