{
  "name": "speaksharp_app",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "expo": "~58.0.21",
    "expo-asset": "~58.0.19",
    "expo-audio": "~58.0.10",
    "expo-blur": "~58.0.5",
    "expo-constants": "~58.0.14",
    "expo-crypto": "~58.0.7",
    "expo-file-system": "~58.0.13",
    "expo-font": "~58.0.11",
    "expo-linking": "~58.0.15",
    "expo-router": "~58.0.28",
    "expo-status-bar": "~58.0.4",
    "firebase": "^12.19.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-web": "^0.21.4"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test:offline": "node --test tests/offlineRecordings.test.cjs tests/attemptFlowPresentation.test.cjs",
    "test:account-deletion": "node --test functions/accountDeletion.test.js tests/offlineRecordings.test.cjs tests/attemptFlowPresentation.test.cjs",
    "test:account-deletion:emulator": "firebase emulators:exec --project demo-speaksharp --config firebase.test.json --only auth,firestore,storage \"node --test functions/test/accountDeletion.emulator.test.js\"",
    "test:rules": "firebase emulators:exec --project demo-speaksharp --config firebase.test.json --only firestore,storage \"node --test tests/firestore.rules.test.js functions/test/rules.test.js functions/adminAccountStatusOperations.emulator.test.js\"",
    "test:components": "jest --config jest.component.config.js components/screens/AdminUserDetailsScreen.test.js",
    "test:admin-demo": "firebase emulators:exec --project demo-speaksharp --config firebase.test.json --only auth,firestore \"node --test functions/test/adminDemo.emulator.test.js\""
  },
  "private": true,
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@react-native/jest-preset": "^0.88.1",
    "@testing-library/react-native": "^14.0.0",
    "firebase-tools": "^15.34.2",
    "jest": "^30.5.2",
    "jest-expo": "^58.0.13",
    "react-test-renderer": "19.3.0"
  }
}
